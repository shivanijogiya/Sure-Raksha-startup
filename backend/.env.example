# ─────────────────────────────────────────────
#  Suraksha — backend/.env.example
#  Copy to .env for LOCAL development only.
#  In production these live in Google Secret Manager
#  and are injected by Cloud Run (see deploy/deploy.sh).
#  NEVER put real values in this file.
# ─────────────────────────────────────────────

PORT=5000

# MongoDB Atlas — Atlas → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/suraksha?retryWrites=true&w=majority

# Browser origins allowed to call the API directly (comma-separated).
# Not needed in production when Firebase Hosting proxies /api/**.
CORS_ORIGINS=http://localhost:3000

# ── Google Gemini ────────────────────────────
# Option A (local / AI Studio): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B (Cloud Run / Vertex AI, no key needed — uses the service account):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
# GOOGLE_CLOUD_LOCATION=asia-south1

# Model is a setting, not code. Change when a newer one is released.
GEMINI_MODEL=gemini-2.5-flash
# Set to "off" to disable AI triage of complaints
GEMINI_TRIAGE=on

# ── Legacy (to be replaced in later phases) ──
PINATA_API_KEY=
PINATA_SECRET_KEY=
POLYGON_RPC_URL=
DEPLOYER_PRIVATE_KEY=
CONTRACT_ADDRESS=
